---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social preview image, as a site-root-relative path. */
  image?: string;
  /** Describes the preview image for screen readers on platforms that expose it. */
  imageAlt?: string;
}

const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'VibeTrunk — vibe-coded tools and games',
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs; without it there is no
// absolute URL to hand to canonical / Open Graph tags. Crawlers reject a
// relative og:image, so this has to be absolute too.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VibeTrunk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100f0d" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <slot />
  </body>
</html>
