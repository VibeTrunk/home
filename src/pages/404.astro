---
import Base from '../layouts/Base.astro';
---

<Base
  title="Not found — VibeTrunk"
  description="That page is not in the trunk."
>
  <main class="page">
    <p class="kicker">&gt; find /trunk -name "this-page"_</p>
    <h1 class="wordmark">404</h1>
    <p class="lede">Not in the trunk — that page does not exist, or has not been built yet.</p>
    <a class="back" href="/"><span aria-hidden="true">&larr;</span> Back to the trunk</a>
  </main>
</Base>

<style>
  .page {
    max-width: 34rem;
    margin: 0 auto;
    padding: clamp(4rem, 15vw, 8rem) clamp(1.25rem, 5vw, 2.5rem) 3rem;
  }

  .kicker {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--mist-dim);
  }

  .wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 12vw, 4.5rem);
    letter-spacing: -0.02em;
    color: var(--paper);
    text-shadow:
      3px 3px 0 var(--cyan),
      6px 6px 0 var(--orange);
  }

  .lede {
    margin: 1.25rem 0 2rem;
    color: var(--mist);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--cyan);
    padding: 0.6rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ink-deep);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .back:hover,
  .back:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink-deep);
  }
</style>
