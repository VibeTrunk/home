---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { sortedTools } from '../data/tools';

const title = 'VibeTrunk — small tools and games';
const description =
  'A trunk full of small, self-contained tools and games. Each one ships on its own and gets added here when it is ready.';
---

<Base title={title} description={description}>
  <main class="page">
    <header class="intro">
      <p class="wordmark">VibeTrunk</p>
      <h1 class="tagline">A trunk full of small tools and games.</h1>
      <p class="lede">
        Each one is built for the fun of it, shipped on its own, and listed here
        once it works. The trunk fills up slowly.
      </p>
    </header>

    <section class="tools" aria-labelledby="tools-heading">
      <h2 class="section-label" id="tools-heading">Inside</h2>

      {
        sortedTools.length === 0 ? (
          <p class="empty">Nothing has shipped yet. The first tool is on its way.</p>
        ) : (
          <ul class="grid" role="list">
            {sortedTools.map((tool) => (
              <li>
                <ToolCard tool={tool} />
              </li>
            ))}
            <li class="placeholder" aria-hidden="true">
              <span>More coming</span>
            </li>
          </ul>
        )
      }
    </section>

    <footer class="foot">
      <span>vibetrunk.com</span>
      <a href="https://github.com/VibeTrunk">GitHub</a>
    </footer>
  </main>
</Base>

<style>
  .page {
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 12vw, 7rem) clamp(1.25rem, 5vw, 2.5rem) 3rem;
  }

  .intro {
    max-width: 34rem;
  }

  .wordmark {
    margin: 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tagline {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .tools {
    margin-top: clamp(3rem, 9vw, 5rem);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  /* Each card fills its grid cell so a row stays visually even. */
  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    flex: 1;
  }

  .placeholder {
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 7.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    opacity: 0.6;
  }

  .empty {
    margin: 0;
    color: var(--fg-muted);
  }

  .foot {
    display: flex;
    gap: 1.25rem;
    margin-top: clamp(4rem, 12vw, 7rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .foot a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  .foot a:hover,
  .foot a:focus-visible {
    color: var(--accent);
  }
</style>
