---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import TrunkIllustration from '../components/TrunkIllustration.astro';
import { sortedTools } from '../data/tools';

const title = 'VibeTrunk — small tools and games';
const description =
  'A trunk full of small, self-contained tools and games. Each one ships on its own and gets added here when it is ready.';

// Live tools cycle through the three tag colors in ship order; coming-soon
// tools always get the muted tab, so tab saturation itself signals "shipped"
// at a glance instead of needing a legend.
const liveAccents = ['cyan', 'orange', 'yellow'] as const;
let liveCount = 0;
---

<Base title={title} description={description}>
  <main class="page">
    <header class="hero">
      <div class="hero-copy">
        <p class="kicker">&gt; whoami_</p>
        <h1 class="wordmark">VibeTrunk</h1>
        <p class="tagline">&gt; vibe-coded tools &amp; games<span class="cursor">_</span></p>
        <p class="lede">
          Each one is built for the fun of it, shipped on its own, and packed
          into the trunk once it works. The trunk fills up slowly.
        </p>
        <a class="cta" href="https://github.com/VibeTrunk">
          <span>View the source</span>
          <span class="cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <TrunkIllustration />
    </header>

    <section class="tools" aria-labelledby="tools-heading">
      <div class="section-label">
        <h2 id="tools-heading">$ ls ./trunk</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      {
        sortedTools.length === 0 ? (
          <p class="empty">&gt; trunk is empty. first tool packing now_</p>
        ) : (
          <ul class="grid" role="list">
            {sortedTools.map((tool, i) => {
              const accent =
                tool.status === 'live' ? liveAccents[liveCount++ % liveAccents.length] : undefined;
              return (
                <li>
                  <ToolCard tool={tool} index={i + 1} accent={accent} />
                </li>
              );
            })}
            <li class="placeholder" aria-hidden="true">
              <span>More coming</span>
            </li>
          </ul>
        )
      }
    </section>

    <footer class="foot">
      <p class="prompt"><span class="who">guest</span>@vibetrunk:~$<span class="cursor">_</span></p>
      <div class="foot-links">
        <span>vibetrunk.com</span>
        <a href="https://github.com/VibeTrunk">github.com/VibeTrunk</a>
      </div>
    </footer>
  </main>
</Base>

<style>
  .page {
    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 5rem) clamp(1.25rem, 5vw, 2.5rem) 3rem;
  }

  /* ---------- hero ---------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  @media (max-width: 46rem) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .kicker {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mist-dim);
  }

  .wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(2.75rem, 9vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--paper);
    text-shadow:
      3px 3px 0 var(--cyan),
      6px 6px 0 var(--orange);
  }

  .tagline {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    letter-spacing: 0.02em;
    color: var(--cyan);
  }

  .cursor {
    display: inline-block;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .lede {
    margin: 1.1rem 0 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    color: var(--mist);
    text-wrap: pretty;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 0.7rem 1.1rem;
    background: var(--cyan);
    color: var(--ink);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 6px;
    box-shadow: 4px 4px 0 var(--ink-deep);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .cta:hover,
  .cta:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink-deep);
  }

  .cta-arrow {
    transition: transform var(--transition);
  }

  .cta:hover .cta-arrow {
    transform: translateX(2px);
  }

  /* ---------- sections ---------- */

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }

  .section-label h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--mist);
    white-space: nowrap;
  }

  .section-label .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .tools {
    margin-top: clamp(4rem, 10vw, 6rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.5rem 1.25rem;
    margin: 0;
    padding: 0;
  }

  /* Each card fills its grid cell so a row stays visually even. */
  .grid > li {
    display: flex;
    padding-top: 0.5rem;
  }

  .grid > li > :global(*) {
    flex: 1;
  }

  .placeholder {
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 8rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mist-dim);
    transform: rotate(-0.6deg);
  }

  .empty {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--mist);
  }

  /* ---------- footer ---------- */

  .foot {
    margin-top: clamp(4rem, 12vw, 7rem);
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .foot .prompt {
    margin: 0 0 0.6rem;
    color: var(--mist);
  }

  .foot .who {
    color: var(--yellow);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    color: var(--mist);
  }

  .foot-links a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  .foot-links a:hover,
  .foot-links a:focus-visible {
    color: var(--cyan);
  }
</style>
